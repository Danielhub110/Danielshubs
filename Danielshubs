-- Toggle button creator
local function createToggleButton(text, positionY, globalVarName, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 240, 0, 45)
    btn.Position = UDim2.new(0, 15, 0, positionY)
    btn.BackgroundColor3 = _G[globalVarName]
        and Color3.fromRGB(0, 180, 100)
        or Color3.fromRGB(25, 55, 110)

    btn.Text = text .. (_G[globalVarName] and " [ON]" or " [OFF]")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 15
    btn.Parent = ContentFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        _G[globalVarName] = not _G[globalVarName]

        btn.BackgroundColor3 = _G[globalVarName]
            and Color3.fromRGB(0, 180, 100)
            or Color3.fromRGB(25, 55, 110)

        btn.Text = text .. (_G[globalVarName] and " [ON]" or " [OFF]")

        if callback then
            callback()
        end
    end)
end

