-- Find dropped gun
local function locateGunDrop()
    local gun = Workspace:FindFirstChild("GunDrop")
    if gun then
        return gun
    end

    for _, v in ipairs(Workspace:GetChildren()) do
        if v:IsA("Folder") or v:IsA("Model") then
            local mapGun = v:FindFirstChild("GunDrop", true)
            if mapGun then
                return mapGun
            end
        end
    end

    return nil
end

-- Player Role ESP
local function applyESP(player)
    local function setupHighlight(char)
        task.wait(1)

        if not char or not char.Parent then
            return
        end

        local old = char:FindFirstChild("RoleESP")
        if old then
            old:Destroy()
        end

        local highlight = Instance.new("Highlight")
        highlight.Name = "RoleESP"
        highlight.Parent = char
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Enabled = _G.MM2_ESP_Enabled
        highlight.FillColor = Color3.fromRGB(0, 255, 0)

        task.spawn(function()
            while char.Parent and highlight.Parent do
                highlight.Enabled = _G.MM2_ESP_Enabled

                if _G.MM2_ESP_Enabled then
                    local backpack = player:FindFirstChild("Backpack")
                    local hasKnife =
                        (backpack and backpack:FindFirstChild("Knife"))
                        or char:FindFirstChild("Knife")

                    local hasGun =
                        (backpack and backpack:FindFirstChild("Gun"))
                        or char:FindFirstChild("Gun")

                    if hasKnife then
                        highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    elseif hasGun then
                        highlight.FillColor = Color3.fromRGB(0, 0, 255)
                    else
                        highlight.FillColor = Color3.fromRGB(0, 255, 0)
                    end
                end

                task.wait(1)
            end
        end)
    end

    if player.Character then
        task.spawn(setupHighlight, player.Character)
    end

    player.CharacterAdded:Connect(setupHighlight)
end

for _, player in ipairs(Players:GetPlayers()) do
    applyESP(player)
end

Players.PlayerAdded:Connect(applyESP)

local function updateAllESPHighlights()
    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        local highlight = char and char:FindFirstChild("RoleESP")

        if highlight then
            highlight.Enabled = _G.MM2_ESP_Enabled
        end
    end
end

-- Teleport to dropped gun and return
local function teleportToGun()
    local character = LocalPlayer.Character
    local gunDrop = locateGunDrop()

    if character and gunDrop then
        local originalCFrame = character:GetPivot()
        character:PivotTo(gunDrop:GetPivot() * CFrame.new(0, 1.5, 0))

        task.wait(0.25)
        character:PivotTo(originalCFrame)
    else
        warn("Gun drop not found.")
    end
end

-- Gun ESP and optional auto-grab loop
task.spawn(function()
    while task.wait(0.3) do
        local gunDrop = locateGunDrop()

        if gunDrop then
            local gunHighlight = gunDrop:FindFirstChild("GunHighlight")

            if _G.GunESP_Enabled then
                if not gunHighlight then
                    gunHighlight = Instance.new("Highlight")
                    gunHighlight.Name = "GunHighlight"
                    gunHighlight.FillColor = Color3.fromRGB(255, 255, 0)
                    gunHighlight.FillTransparency = 0.2
                    gunHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    gunHighlight.Parent = gunDrop
                end
            elseif gunHighlight then
                gunHighlight:Destroy()
            end
        end
    end
end)

